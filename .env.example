# Copy to .env (never commit the real file).
# SEC asks automated clients to identify themselves: app name + contact email.
SEC_USER_AGENT="Tickmark research Your Name you@example.com"
# DeepSeek API key — used by the data pipeline (memos) and the live API (/api/py/*).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: shown in the nav / landing page.
NEXT_PUBLIC_REPO_URL=https://github.com/yuzonglinsam/tickmark
NEXT_PUBLIC_SITE_URL=https://tickmark-gules.vercel.app
NEXT_PUBLIC_LINKEDIN_URL=
# Optional: serve the Flask API from another host (e.g. Render) instead of Vercel functions.
API_ORIGIN=
